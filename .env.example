# ==============================================================================
# Invoice Rescue — Environment Variables Reference (.env.example)
# ==============================================================================
# This file is COMMITTED to the repository as a template.
# It contains ONLY placeholder values — never real credentials.
#
# To set up local development:
#   1. Copy this file:  copy .env.example .dev.vars
#   2. Fill in real test values (see comments below for where to get each one)
#   3. For production secrets run:  npx wrangler secret put <SECRET_NAME>
#
# Variable categories:
#   [SECRET]  → deploy with `wrangler secret put`, set in .dev.vars for local dev
#   [VAR]     → set in wrangler.jsonc [vars] block (not secret, committed)
#   [ENV]     → set in your shell environment (e.g. for wrangler CLI auth)
# ==============================================================================

# ── AI Drafting ────────────────────────────────────────────────────────────────
# [SECRET] Google Gemini API key for AI email drafting
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [SECRET] OpenRouter API key (optional fallback model provider)
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Stripe ─────────────────────────────────────────────────────────────────────
# [SECRET] Stripe secret key — use TEST key (sk_test_*) for local dev
# [SECRET]                     use LIVE key (sk_live_*) in production ONLY via wrangler secret put
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_SECRET_TEST_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_SECRET_LIVE_KEY=LEAVE_EMPTY_FOR_LOCAL_DEV

# [VAR] Stripe publishable key — safe to expose client-side (already in wrangler.jsonc)
# STRIPE_PUBLISHABLE_KEY is set in wrangler.jsonc [vars], not here.
STRIPE_PUBLISHABLE_TEST_KEY=pk_test_your_stripe_test_publishable_key_here

# [SECRET] Stripe webhook signing secrets
# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_WEBHOOK_SECRET_TEST=whsec_your_test_webhook_signing_secret_here
STRIPE_WEBHOOK_SECRET_LIVE=LEAVE_EMPTY_FOR_LOCAL_DEV

# ── Admin Panel ────────────────────────────────────────────────────────────────
# [SECRET] HTTP Basic Auth password for the /admin review queue
# Local dev: use any string, e.g. "local-dev-secret"
# Production: use a long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET=your_admin_password_here

# ── Client Portal ──────────────────────────────────────────────────────────────
# [SECRET] HMAC-SHA256 signing key for magic links and portal sessions
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_SECRET=your_64_char_hex_secret_here

# ── Cloudflare R2 (document/report storage) ────────────────────────────────────
# [SECRET] R2 S3-compatible API credentials
# Get from: Cloudflare Dashboard → R2 → Manage API tokens
ACCESS_KEY_ID=your_r2_access_key_id_here
SECRET_ACCESS_KEY=your_r2_secret_access_key_here
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ── Cloudflare CLI Auth ────────────────────────────────────────────────────────
# [ENV] Used by wrangler CLI for deployments — set in your shell or CI secrets
#       Do NOT put this in .dev.vars; wrangler dev does not need it for local runs
# export CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# ── Non-Secret Config (set in wrangler.jsonc [vars], not here) ────────────────
# BOE_BASE_RATE_PERCENT  = 3.75   (Bank of England base rate for statutory interest)
# OPERATOR_NAME          = Tibor  (shown in portal audit trail)
# NOTIFY_TO              = tiborcc2@gmail.com  (operator notification address)
# NOTIFY_FROM            = hello@invoicerescue.co.uk
# STRIPE_PUBLISHABLE_KEY = pk_test_... (test) / pk_live_... (prod, in wrangler vars)
