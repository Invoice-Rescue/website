# ==============================================================================
# Invoice Rescue — Environment Variables & Secrets Reference
# ==============================================================================
# Copy this file to .dev.vars for local development:
#   cp .env.example .dev.vars
#
# In production, deploy secrets using:
#   npx wrangler secret put <SECRET_NAME>
#
# NEVER commit .dev.vars or any file containing real credentials to version control.
# ==============================================================================

# AI Drafting
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Operator Admin Authentication (HTTP Basic Auth password for /admin)
ADMIN_SECRET=your_long_random_admin_password_here

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client Portal Authentication (HMAC-SHA256 key for magic links & sessions)
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=your_32_byte_hex_session_secret_here

# Cloudflare Deployments & Worker Bindings
CLOUDFLARE_API_TOKEN=cfat_...
BOE_BASE_RATE_PERCENT=3.75
OPERATOR_NAME=Operator
NOTIFY_TO=operator@example.com
NOTIFY_FROM=hello@invoicerescue.co.uk
INBOX_FORWARD_TO=operator@invoicerescue.co.uk
