{
  "name": "invoice-rescue",
  "version": "1.0.0",
  "description": "AI-assisted credit-control service for UK service businesses — every overdue invoice chased in the client's name, escalating and professional, until it's paid. 12%-success-fee model retired; current pricing is subscription tiers (see [docs/business-plan.html](docs/business-plan.html)): Foundation £349/mo, Engine £649/mo, Operator £1,250/mo.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deps:check": "npm outdated",
    "deps:update": "npm update && npm run typecheck && npm run build",
    "deps:audit": "npm audit",
    "git:repair": "powershell -ExecutionPolicy Bypass -File scripts/git-repair-index.ps1",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npx tsx --test tests/**/*.test.ts",
    "e2e": "npx playwright test",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "verify": "npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invoice-Rescue/website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Invoice-Rescue/website/issues"
  },
  "homepage": "https://github.com/Invoice-Rescue/website#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
